<apex:page controller="ReporteMargenDetail" standardStylesheets="false" applyHtmlTag="false"  applyBodyTag="false" showHeader="false">
  <head>
    <style>

      .tabla {
        border-collapse: collapse;
      }

      .tituloColumnaClave {
         text-align: center;        
         border-collapse: collapse;
         border: 2px solid black;
         background-color: #C5D9F0;
         width: 60px;
         font-size: 12px;
         height: 15px; 
         font-weight: bold;
         padding: 8px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .tituloColumna {
         text-align: center;        
         white-space:pre-line;
         border-collapse: collapse;
         border: 2px solid black;
         background-color: #C5D9F0;
         width: 150px;
         font-size: 12px;
         height: 15px; 
         font-weight: bold;
         padding: 8px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .tituloColumnaTotales {
         text-align: left;        
         border-collapse: collapse;
         border: 2px solid black;
         background-color: #C4D69B;
         width: 150px;
         font-size: 12px;
         height: 15px; 
         font-weight: bold;
         padding: 8px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumna {
         border-collapse: collapse;
         border: 1px solid black;
         background-color: #FFFFFF;
         width: 150px;
         font-size: 12px;
         height: 15px;
         text-align: left;
         font-weight: bold;
         padding: 6px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumnaLim {
         border-collapse: collapse;
         border-top:    1px solid black;
         border-right:  1px solid black;
         border-bottom: 1px solid black;
         border-left:   2px solid black;
         background-color: #FFFFFF;
         width: 90px;
         font-size: 12px;
         height: 15px;
         text-align: center;
         font-weight: bold;
         padding: 6px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumnaNumber {
         border-collapse: collapse;
         border-top:    1px solid black;
         border-right:  2px solid black;
         border-bottom: 1px solid black;
         border-left:   1px solid black;
         background-color: #8DB4E2;
         width: 150px;
         font-size: 12px;
         height: 15px;
         text-align: center;
         font-weight: bold;
         padding: 6px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumnaNumberLim {
         border-collapse: collapse;
         border-top:    1px solid black;
         border-right:  1px solid black;
         border-bottom: 1px solid black;
         border-left:   2px solid black;
         background-color: #8DB4E2;
         width: 150px;
         font-size: 12px;
         height: 15px;
         text-align: center;
         font-weight: bold;
         padding: 6px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumnaTotal {
         border-collapse: collapse;
         border: 2px solid black;
         background-color: #538DD5;
         width: 150px;
         font-size: 12px;
         height: 15px;
         text-align: center;
         font-weight: bold;
         padding: 8px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .valueColumnaTotalMargen {
         border-collapse: collapse;
         border: 2px solid black;
         background-color: #FF0201;
         width: 150px;
         font-size: 12px;
         height: 15px;
         text-align: center;
         font-weight: bold;
         padding: 8px;
         font-family: Arial, Helvetica, sans-serif;
      }

      .tituloGeneral {
        white-space:pre;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        font-family: Arial, Helvetica, sans-serif;        
      }

    </style>
  </head>

  <body>

<table class="tabla">

  <tr>
    <td class="tituloGeneral" colspan="8"><apex:outputText >Ventas {!currentYear}</apex:outputText></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
  </tr>

  <tr>
   <td class="tituloColumna"><apex:outputText >CLIENTE</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >COMPRADOR</apex:outputText></td>      
   <td class="tituloColumna"><apex:outputText >PAíS</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >OBJETIVO VENTA</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >VENTA REAL</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >DESVIACIÓN</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >MARGEN OBJETIVO</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >MARGEN REAL</apex:outputText></td>
   <td class="tituloColumna"><apex:outputText >DESVIACIÓN MARGEN</apex:outputText></td>
  </tr>

  <apex:repeat value="{!clientesContacto}" var="cli">  
  <tr>
   <td class="valueColumna"><apex:outputText >{!cli.cliente}</apex:outputText></td>  
   <td class="valueColumnaLim"><apex:outputLink value="/lightning/r/Report/00O0f000007GhnPEAS/view?queryScope=userFolders&fv0={!cli.name}">{!cli.comprador}</apex:outputLink></td>
   <td class="valueColumna"><apex:outputText >{!cli.account.BillingCountry}</apex:outputText></td>
   <td class="valueColumnaNumberLim">
     <apex:outputText value="${0, number, ###,###,##0}">
       <apex:param value="{!cli.objetivoVentaNeta}"/>       
     </apex:outputText>
   </td>
   <td class="valueColumnaNumberLim">
     <apex:outputText value="${0, number, ###,###,##0}">
      <apex:param value="{!cli.importeVentaNetoGeneral}" />
     </apex:outputText>
   </td>
   <td class="valueColumnaNumberLim">
     <apex:outputText value="${0, number, 0.0}%">
      <apex:param value="{!cli.desviacion}" />
     </apex:outputText>
   </td>
   <td class="valueColumnaNumber">
     <apex:outputText value="{0, number, 0.0}%">
       <apex:param value="{!cli.margenObjetivoNeta}"/>
     </apex:outputText>
   </td>
   <td class="valueColumnaNumber">
      <apex:outputText value="{0,number, 0.0}%">
       <apex:param value="{!cli.margenReal}"/>
      </apex:outputText>
   </td>
   <td class="valueColumnaNumberLim">
     <apex:outputText value="${0, number, 0.0}%">
      <apex:param value="{!cli.desviacionMargen}" />
     </apex:outputText>
   </td>
  </tr>
  </apex:repeat> 

  <tr>
   <td colspan="3" class="tituloColumnaTotales"><apex:outputText >TOTALES</apex:outputText></td>
   <td class="valueColumnaTotal">
      <apex:outputText value="${0,number, ###,###,##0}">
       <apex:param value="{!objetivoVentaGeneral}"/>
      </apex:outputText>
   </td>
   <td class="valueColumnaTotal">
     <apex:outputText value="${0, number, ###,###,##0}">
      <apex:param value="{!importeVentaNetoGeneral}" />   
     </apex:outputText>
   </td>
   <td class="valueColumnaTotal">
     <apex:outputText value="${0, number, ###,###,##0}">
      <apex:param value="{!desviacionTotal}" />   
     </apex:outputText>
   </td> <!-- desviacion -->
   <td class="valueColumnaTotal">
      <apex:outputText value="{0,number, 0.0}%">
       <apex:param value="{!objetivoVentaMargenTotal}"/>
      </apex:outputText>
   </td>
   <td class="valueColumnaTotalMargen">
      <apex:outputText value="{0,number, 0.0}%">
       <apex:param value="{!margenReal}"/>
      </apex:outputText>
   </td>
   <td class="valueColumnaTotal">
     <apex:outputText value="${0, number, ###,###,##0}">
      <apex:param value="{!desviacionMargenTotal}" />  
     </apex:outputText>
   </td> <!-- desviacion margen -->
  </tr>

</table>

</body>	
</apex:page>