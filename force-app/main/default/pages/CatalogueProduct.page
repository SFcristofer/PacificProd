<apex:page docType="html-5.0" showHeader="false" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" Controller="CatalogoController" cache="false">


    <html class="no-js" lang="en" dir="ltr">
        <head>
            <meta charset="utf-8"/>
            <meta http-equiv="x-ua-compatible" content="ie=edge"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title>{!productoWrapper.product.ProductoBase__r.Name} - {!catalogoGUI.currentSubfamily.descripcion} - Online Catalog - Pacific Global</title>
            <link href="https://fonts.googleapis.com/css?family=Fira+Sans:300,300i,400,400i,500,500i,700,700i,900,900i|Montserrat:200,400,600,700,800" rel="stylesheet"/>
            <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.2/css/all.css" integrity="sha384-oS3vJWv+0UjzBfQzYUhtDYW+Pj2yciDJxpsK1OYPAYjqT085Qq/1cq5FLXAZQ7Ay" crossorigin="anonymous"/>
            <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/foundation.css')}"/>
            <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick.css')}"/>
            <!-- Add the new slick-theme.css if you want the default styling -->
            <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick-theme.css')}"/>
            <!-- Custom styles -->
            <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/app.css')}"/>
            <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/responsive.css')}"/>
        </head>
        <body id="{!catalogoGUI.bodyTag}">
            <apex:form id="formIT">
            <div styleClass="grid-container">
                <div id="header" class="grid-x grid-padding-x">
                    <div class="small-6 medium-3 cell">
                        <a href="/portal/CatalogueIndex"><img id="inner-logo" src="{!URLFOR($Resource.doBrandsCatalogoImages, 'img/pacific-logo.svg')}" alt="pacific logo" style="width:auto;height:96px;"/></a>
                    </div>
                    <div class="medium-9 cell hide-for-small show-for-large">
                        <ul id="main-menu" class="align-right dropdown menu" data-dropdown-menu="true">
                            <li id="go-home">
                                <a href="/portal/CatalogueIndex"><span>Home</span></a>
                            </li>


                            <apex:repeat value="{!catalogoGUI.familias}" var="itemF">
                                <apex:variable var="imageMSF" value="{!itemF.imagenSF}"/>
                                
                                <li id="go-do-home" class="{!itemF.cssOrStyle}"><a href="/portal/CatalogueSubfamily?fam={!itemF.clave}" class="{!itemF.classSubfamiliaMenu}"><span><img src="{!URLFOR($Resource.doBrandsCatalogoImages, imageMSF)}" class="{!itemF.cssOrStyle}" style="width:139px;height:32px;"/></span></a>
                                    <ul class="menu">
                                        <apex:repeat value="{!itemF.subfamilias}" var="itemMS">
                                            <li><a href="/portal/CatalogueClase?fam={!catalogoGUI.currentFamily.clave}&sfm={!itemMS.clave}">{!itemMS.descripcion}</a></li>
                                        </apex:repeat>
                                    </ul>
                                </li>
                                
                            </apex:repeat>


                            <li id="cart">
                                <apex:outputPanel id="cart">
                                    <a href="/portal/CataloguePedido" style="{!styleCartHref}">
                                        <i class="fas fa-dolly-flatbed"></i>
                                        <span style="{!styleCartSpan}">{!IF(numberProductsCart != '0', numberProductsCart, '')}</span>
                                    </a>
                                </apex:outputPanel>
                            </li>
                        </ul>
                    </div>
                    <div id="responsive-menu-header" class="small-6 medium-9 cell hide-for-large">
                        <ul class="menu">
                            <li id="cart">
                                <apex:outputPanel id="cart-responsive">
                                    <a href="/portal/CataloguePedido" style="{!styleCartHref}">
                                        <i class="fas fa-dolly-flatbed"></i>
                                        <span style="{!styleCartSpan}margin:0px !important;">{!IF(numberProductsCart != '0', numberProductsCart, '')}</span>
                                    </a>
                                </apex:outputPanel>
                            </li>
                            <li id="show-menu"><a href="#show-menu"><i class="fa fa-bars" aria-hidden="true"></i></a></li>
                            <li id="hide-menu"><a href="#hide-menu"><i class="fa fa-times" aria-hidden="true"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            
            <!-- Responsive Menu -->
            <div id="responsive-menu">
                <div class="grid-container">
                    <div class="grid-x">
                        <div class="small-12 cell">
                            <ul id="" class="">
                                <apex:repeat value="{!catalogoGUI.familias}" var="itemF">
                                    <li id="go-do-home">
                                        <a href="/portal/CatalogueSubfamily?fam={!itemF.clave}" class="{!itemF.classSubfamiliaMenu}">
                                            <span>
                                                <img src="{!URLFOR($Resource.doBrandsCatalogoImages, itemF.imagenSF)}" class="{!itemF.cssOrStyle}" />
                                            </span>
                                        </a>
                                    </li>
                                </apex:repeat>
                                <li id="go-home">
                                    <a href="/portal/CatalogueIndex">
                                        <span>Home</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            
            
            <div class="grid-container">
                <div class="grid-x grid-padding-x">
                    <div class="small-12 cell">
                        <nav aria-label="You are here:" role="navigation">
                            <ul class="breadcrumbs">
                                <li><a href="/portal/CatalogueSubfamily?fam={!catalogoGUI.currentFamily.clave}">{!catalogoGUI.currentFamily.descripcion}</a></li>
                                <li><a href="/portal/CatalogueClase?fam={!catalogoGUI.currentFamily.clave}&sfm={!catalogoGUI.currentSubfamily.clave}#{!productoWrapper.product.ProductoBase__r.ProductCode}">{!catalogoGUI.currentSubfamily.descripcion}</a></li>
                                <li><a href="/portal/CatalogueClase?fam={!catalogoGUI.currentFamily.clave}&sfm={!catalogoGUI.currentSubfamily.clave}&cla={!catalogoGUI.currentClassPrefix}#{!productoWrapper.product.ProductoBase__r.ProductCode}">{!catalogoGUI.currentClassName}</a></li>
                                <li><span class="show-for-sr">Current: </span> {!productoWrapper.product.ProductoBase__r.Name}</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
            <div id="product-container" class="grid-container">
                <div class="grid-x grid-padding-x">
                    <div class="small-12 medium-6 large-8 cell">
                        <div class="product-img-slider-container">
                            <div class="product-img-slider">
                                <div>
                                    <img src="/portal/servlet/servlet.FileDownload?file={!IF(productoWrapper.product.ProductoBase__r.IDImagen1__c != null, productoWrapper.product.ProductoBase__r.IDImagen1__c, '015460000005lAl')}"/>
                                </div>
                                <div style="{!productoWrapper.image2Display}">
                                    <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen2__c}"/>
                                </div>
                                <div style="{!productoWrapper.image3Display}">
                                    <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen3__c}"/>
                                </div>
                            </div>
                        </div>
                        <div class="slider slider-nav">
                            <div style="{!productoWrapper.image1Display}">
                                <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen1__c}"/>
                            </div>
                            <div style="{!productoWrapper.image2Display}">
                                <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen2__c}"/>
                            </div>
                            <div style="{!productoWrapper.image3Display}">
                                <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen3__c}"/>
                            </div>
                        </div>
                    </div>
                    <div id="product-info" class="small-12 medium-6 large-4 cell">
                        <h2>{!productoWrapper.product.ProductoBase__r.Name}</h2>
                        <ul class="no-bullet">
                            <li><strong>Code:</strong> {!productoWrapper.product.ProductoBase__r.ProductCode}</li>
                            <li><strong>Sizes:</strong> {!productoWrapper.product.ProductoBase__r.Medidas_Agrupadas__c}</li>
                            <li><strong>Material:</strong> {!productoWrapper.product.ProductoBase__r.Material__c}</li>
                            <li><strong>Color:</strong> {!productoWrapper.product.ProductoBase__r.Color__c}</li>
                            <li><strong>Packaging:</strong> {!RIGHT(productoWrapper.product.ProductoBase__r.Packaging__c, LEN(productoWrapper.product.ProductoBase__r.Packaging__c) - 2)}</li>
                            <li><strong>Masterbox (units):</strong> {!productoWrapper.product.ProductoBase__r.UnidadesPorMasterBox__c}</li>
                            <li><strong>20ft Container (units):</strong> 
                                <apex:outputText value="{0, number, ##,###,###.##}">
                                    <apex:param value="{!productoWrapper.product.ProductoBase__r.UnidadesContainer20__c}"/>
                                </apex:outputText>
                            </li>
                            <li><strong>40ft Container (units):</strong>
                                <apex:outputText value="{0, number, ##,###,###}">
                                    <apex:param value="{!productoWrapper.product.ProductoBase__r.UnidadesContainer40__c}"/>
                                </apex:outputText>
                            </li>
                            <li><strong>40ft HQ Container (units):</strong>
                                <apex:outputText value="{0, number, ##,###,###}">
                                    <apex:param value="{!productoWrapper.product.ProductoBase__r.UnidadesHQ__c}"/>
                                </apex:outputText>
                            </li>
                        </ul>
                        <apex:outputPanel id="CartButton" layout="none">
                            <apex:outputPanel rendered="{!NOT(AlreadyAdded)}">
                                <a class="button" data-close="false" onClick="addItemJS()" style="padding: 0.85em 2em;"> Add to quote</a>
                            </apex:outputPanel>
                            <apex:outputLink id="add-to-cart" styleClass="button clear" html-data-open="add-to-cart-modal" rendered="{!NOT(AlreadyAdded)}" onclick="return false;">Add with comment</apex:outputLink>
                            <apex:commandLink id="rem-from-cart" styleClass="button" action="{!removeFromCart}" rendered="{!AlreadyAdded}" reRender="CartButton, cart, cart-responsive">Remove from quote</apex:commandLink>
                        </apex:outputPanel>
                    </div>
                </div>
            </div>
            
            
            <div class="reveal" id="add-to-cart-modal" data-reveal="true">
                
                <div id="add-product-iframe">
                
                    <div class="grid-x grid-padding-x">
                        <div class="small-12 cell">
                            <button class="close-button" data-close="false" aria-label="Close modal" type="button"><span aria-hidden="true">&times;</span></button>
                            <div class="product-image-added">
                                <img src="/portal/servlet/servlet.FileDownload?file={!productoWrapper.product.ProductoBase__r.IDImagen1__c}"/>
                            </div>
                            <h3 class="text-center">Add <span class="product-name">{!productoWrapper.product.ProductoBase__r.Name}</span> to quote request.</h3>
                            <div class="divider1"></div>
                            <label>Comment:
                                <textarea id="comments-box" placeholder="Write your comments here..." />
                            </label>
                        </div>
                    </div>
                    <div class="divider1"></div>
                    <div class="grid-x grid-padding-x">
                        <div class="small-6 cell text-center" style="margin:0 auto;">
                            <a class="button" data-close="false" onClick="addItemJS()"> Add </a>
                        </div>
                    </div>
                
                </div>
            </div>
            
            <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/jquery.js')}"></script>
            <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/what-input.js')}"></script>
            <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/foundation.js')}"></script>
            <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/app.js')}"></script>
            <script type="text/javascript" src="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick.min.js')}"></script>
        
            <script type="text/javascript">
                $(document).ready(function(){
                     $('.product-img-slider').slick({
                      slidesToShow: 1,
                      slidesToScroll: 1,
                      arrows: false,
                      fade: true,
                      asNavFor: '.slider-nav'
                    });
                    $('.slider-nav').slick({
                      slidesToShow: 3,
                      slidesToScroll: 1,
                      asNavFor: '.product-img-slider',
                      dots: false,
                      centerMode: true,
                      focusOnSelect: true
                    });
                    
                });
                
                function addItemJS() {
                    var text = document.querySelector("[id*='comments-box']").value;
                    console.log('TEXT FETCHED: ' + text);
                    addItem(text);
                }

            </script>
           <apex:actionFunction name="addItem" action="{!addTocart}" reRender="CartButton, cart, cart-responsive">
                <apex:param name="theComments" value="" assignTo="{!productoWrapper.prodComments}" />
            </apex:actionFunction>

        </apex:form>            
        </body>
    </html>
    
</apex:page>