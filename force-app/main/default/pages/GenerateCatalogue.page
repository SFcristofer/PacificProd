<apex:page id="genCatalogue" standardController="Account" extensions="GenerateCatalogue" lightningStylesheets="true">
    <style>
        .container {
            display: block;
            position: relative;
            padding-left: 35px;
            margin-bottom: 12px;
            cursor: pointer;
            font-size: 22px;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }
    
        .container input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }
    
        .checkmark {
            position: absolute;
            top: 0;
            left: 0;
            height: 1rem;
            width: 1rem;
            background-color: #fff;
            box-shadow: 0 0 3px #0070d2;
        }
    
        .container input:checked ~ .checkmark {
            background-color: #2196F3;
        }
    
        .checkmark:after {
            content: "";
            position: absolute;
            display: none;
        }
    
        .container input:checked ~ .checkmark:after {
            display: block;
        }
    
        .container .checkmark:after {
            left: 6px;
            top: 3px;
            width: 4px;
            height: 8px;
            border: solid white;
            border-width: 0 2px 2px 0;
            -webkit-transform: rotate(45deg);
            -ms-transform: rotate(45deg);
            transform: rotate(45deg);
        }
        .next {
            margin:10px;
            background-color: #2196F3 !important;
            color: #fff !important;
        }

        .pbTitle {
            white-space: nowrap;
        }
        
    </style>
    <apex:form id="catSelForm">
        <apex:pageBlock id="block" title="Generating catalog for {!Account.Name}" >
            <apex:pageMessages />
            <apex:pageBlockButtons id="buttons" location="bottom">
                <apex:commandButton id="cancel" value="Cancel" action="{!finish}" rendered="{!NOT(isGenerated)}"/>
                <apex:commandButton id="back" value="Previous" action="{!back}" rendered="{!AND(NOT(oppNameStep), NOT(isGenerated), NOT(noPlan))}"/>
                <apex:commandButton id="next" value="Next" action="{!forward}" rendered="{!AND(NOT(claSelectionStep), NOT(isGenerated), NOT(noPlan))}" styleClass="next"/>
                <apex:commandButton id="save" value="Generate Catalog" action="{!saveCatalogue}" rendered="{!claSelectionStep}" styleClass="next"/>
                <apex:commandButton id="finish" value="Finish" action="{!finish}" rendered="{!isGenerated}" styleClass="next"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection id="oppNameSelection" rendered="{!oppNameStep}" title="DEFINE THE OPPORTUNITY NAME" columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel for="oppName" value="Opportunity Name" />
                    <apex:inputText id="oppName" value="{!oppName}" />
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="famSelection" rendered="{!famSelectionStep}" title="SELECT THE FAMILY" columns="1">
                <apex:pageBlockTable id="families" value="{!fams}" var="item"
                                    rowClasses="odd,even" columnsWidth="10%,90%">
                    <apex:column >
                        <apex:facet name="header"> Selection </apex:facet>
                        <label class="container">          
                            <apex:inputCheckbox value="{!item.isSelected}"/>
                            <span class="checkmark" />
                        </label>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Family </apex:facet>
                        <apex:outputText id="fam" value="{!item.name}" />
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="subSelection" rendered="{!subSelectionStep}" title="SELECT THE SUB-FAMILY" columns="1">
                <apex:pageBlockTable id="subs" value="{!subFams}" var="item"
                                    rowClasses="odd,even"  columnsWidth="10%,25%,65%">
                    <apex:column >
                        <apex:facet name="header"> Selection </apex:facet>
                        <label class="container">          
                            <apex:inputCheckbox value="{!item.isSelected}"/>
                            <span class="checkmark" />
                        </label>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Family </apex:facet>
                        <apex:outputText id="fam" value="{!item.parent.name}" />
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Sub-Family </apex:facet>
                        <apex:outputText id="sub" value="{!item.name}" />
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="claSelection" rendered="{!claSelectionStep}" title="SELECT THE CLASS" columns="1">
                <apex:pageBlockTable id="classes" value="{!classes}" var="item"
                                    rowClasses="odd,even" columnsWidth="10%,25%,25%,40%">
                    <apex:column >
                        <apex:facet name="header"> Selection </apex:facet>
                        <label class="container">          
                            <apex:inputCheckbox value="{!item.isSelected}"/>
                            <span class="checkmark" />
                        </label>
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Family </apex:facet>
                        <apex:outputText id="fam" value="{!item.parent.parent.name}" />
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Sub-Family </apex:facet>
                        <apex:outputText id="sub" value="{!item.parent.name}" />
                    </apex:column>
                    <apex:column >
                        <apex:facet name="header"> Class </apex:facet>
                        <apex:outputText id="cla" value="{!item.name}" />
                    </apex:column>
                </apex:pageBlockTable>
            </apex:pageBlockSection>
            <apex:pageBlockSection id="endSection" rendered="{!isGenerated}" title="CATALOG GENERATED" columns="1">
                <apex:outputText value="Catalog «{!oppName}» was generated for {!Account.Name} with {!totalProds} products" />
                <apex:outputLink value="{!catURL}"> Link to generated catalog </apex:outputLink>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>