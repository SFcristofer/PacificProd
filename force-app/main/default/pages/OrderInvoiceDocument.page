<apex:page standardController="PedidoDeCompra__c" showHeader="false" renderAs="PDF"
    applyHtmlTag="false" applyBodyTag="false" extensions="OrderInvoiceDocument">
    <head>

<style>

@page{

margin:0.4in;

}

.tableClass{
    border-collapse: collapse;
    width: 100%;
}
.headerRow{
    padding: 5px;
    text-align:center;
    background-color: #D9E1F1;
    border: 1px solid;
    font-size:8px;
}
.summary{
    padding: 5px;
    text-align:center;
    background-color: #D9E1F1;
    font-size:8px;
    border-top:1px solid;
    border-bottom:1px solid;
}

.summary-last-child{
    border-right:1px solid;
}

.summary th:first-child{
    border-left:1px solid;
}

.sub-summary{
    font-weight: bold;
    text-align: left;
    border:1px solid;
}

.dataCell{
    padding: 5px;
    text-align:center;
    font-size:8px;
}

.indent{
    padding-left:130px;
}

.companyTable{
    font-family: "Arial Black", Helvetica, sans-serif;
    color: #36568D;
    font-weight: bold;
}


.tbody-lines::before, .tbody-lines::after
{
  content: '';
  display: block;
  height: 15px;

}

.item-label {
    font-weight: bold;
    width: 100px;
}

.item-data {
    text-align: right;
    width: 100px;
}

.top-align {
    vertical-align: top;
}

</style>

</head> 

    <body>
        <apex:stylesheet value="{!URLFOR($Resource.pdfresources, 'sheet.css')}"/>
        <apex:panelGrid columns="2" columnClasses="left,left">
            <div style='width:500px;font-size:24pt;font-family:"Arial Black", Helvetica, sans-serif;font-weight:bolder;color:#8FAAD9;'>
                COMMERCIAL <br/> INVOICE
            </div>
            <apex:panelGrid columns="1" styleClass="companyTable" width="200px">
                <apex:image value="{!URLFOR($Resource.pdfresources,'DB_logo.png')}" width="150px"/>
                <apex:outputText value="{!razonSocial}"/>
                <apex:outputText value="{!calle}"/>
                <apex:outputText value="{!ciudad}, {!pais} {!division}"/>
                <apex:outputText value="Telf. {!telefono}"/>
                <apex:outputText value="{!correo}"/>
            </apex:panelGrid>
        </apex:panelGrid>   

        <!--  apex:outputPanel layout="block" styleClass="line"/> -->
        <apex:panelGrid columns="2"  width="100%" style="margin-top:20px" columnClasses="none, top-align">
            <apex:panelGrid columns="1">
                <apex:outputText value="Invoice to:" style="font-weight:bold"/>
                <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.RazonSocial__c}"/>
                <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.billingStreet}"/>
                <apex:panelGroup >
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.billingPostalCode}"/>&nbsp;
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.billingCity}"/>
                    <apex:outputText value=", {!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.billingState}"/>
                </apex:panelGroup>
                <apex:panelGroup >
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.BillingCountry}"/>&nbsp;
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.NroIdFiscal__c}"/>
                </apex:panelGroup>
                <apex:outputText value="PH: {!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.phone}"/>
                <br/>
                <apex:outputPanel style="line-height:12pt" rendered="{!NOT(ISBLANK(PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_1__c))}">
                    <apex:outputText value="Consignee to:" style="font-weight:bold"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_1__c}"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_2__c}"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_3__c}"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_4__c}"/><br/>
                    <apex:outputText value=" {!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_5__c}"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Consignee_Linea_6__c}"/>
                </apex:outputPanel>
                
                <apex:panelGrid columns="2" style="margin-left:-6px">
                    <apex:panelGrid columns="2" columnClasses="item-label, item-data">
                        <apex:outputText value="From:"/>
                        <apex:outputText value="{!PedidoDeCompra__c.Proveedor__r.Puerto__c}, {!PedidoDeCompra__c.Proveedor__r.PaisDelPuerto__c}" />
                        <apex:outputText value="Order:"/>
                        <apex:outputText value="{!PedidoDeCompra__c.Numero_de_Orden__c}" />
                    </apex:panelGrid>    
                </apex:panelGrid>
            </apex:panelGrid>

            <apex:panelGrid columns="1" style="float:right">
                <apex:panelGrid columns="2" style="margin-left:-3px" columnClasses="item-label, item-data">
                    <apex:outputText value="Date:" style="font-weight:bold"/>
                    <apex:outputText value="{0, date, dd'/'MM'/'yyyy}">
                       <apex:param value="{!PedidoDeCompra__c.Fecha_Factura__c}" /> 
                    </apex:outputText>
                    <apex:outputText value="Invoice:" style="font-weight:bold"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Numero_de_Factura__c}"/>
                </apex:panelGrid>
                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_1__c))}" style="margin:10px">
                    <apex:outputText value="Notify Party:" style="font-weight:bold"/><br/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_1__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_2__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_3__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_4__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_5__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_6__c}"/>
                    <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.Notify_Party_Linea_7__c}"/>
                </apex:outputPanel>
                <apex:panelGrid columns="2" style="margin-left:-7px">
                    <apex:panelGrid columns="2" columnClasses="item-label, item-data">
                        <apex:outputText value="Country of Origin:"/>
                        <apex:outputText value="China"/>
                        <apex:outputText value="To:"/>
                        <apex:outputText value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.Puerto__c}, {!PedidoDeCompra__c.Proforma__r.Cuenta__r.PaisDelPuerto__c}"/>
                        <apex:outputText value="FOB"/>
                        <apex:outputText value=" "/>
                        <apex:outputText value="Payment Term"/>
                        <apex:outputText value="{0} DAYS">
                            <apex:param value="{!PedidoDeCompra__c.Proforma__r.Cuenta__r.parent.PlazoPago__c}" />
                        </apex:outputText>
                    </apex:panelGrid>    
                </apex:panelGrid>
            </apex:panelGrid>
        </apex:panelGrid>
        <br/><br/><br/><br/>
        <apex:pageBlock >
        <table class="tableClass" border="0" cellpadding="0" cellspacing="0">
            <colgroup span="6"></colgroup>
            <thead class="">
                <tr class="headerRow">
                    <th class="headerRow" scope="col" colspan="1">
                        <div>ITEM NO.</div>
                    </th>
                    <th class="headerRow" scope="col" colspan="1">
                        <div>MARK</div>
                    </th>
                    <th class="headerRow" scope="col" colspan="1">
                        <div>DESCRIPTION</div>
                    </th>
                    <th class="headerRow" scope="col" colspan="1">
                        <div>QTY</div>
                    </th>
                    <th class="headerRow" scope="col" colspan="1">
                        <div>UNIT PRICE (USD)</div>
                    </th>
                    <th class="headerRow" scope="col" colspan="1">
                        <div>AMOUNT (USD)</div>
                    </th>
                </tr>
            </thead>
            <tfoot>
                <tr class="summary">
                    <th class="summary" scope="col" colspan="1"> SUMMARY</th>
                    <th class="summary" scope="col" colspan="1"></th>
                    <th class="summary" scope="col" colspan="1"></th>
                    <th class="summary" scope="col" colspan="1"><apex:outputField value="{!PedidoDeCompra__c.Total_Cantidad__c}"/>
                    </th>
                    <th class="summary" scope="col" colspan="1"></th>
                    <th scope="col" colspan="1" class="summary summary-last-child"><apex:outputField value="{!PedidoDeCompra__c.Precio_Total__c}"/></th>
                </tr>
            </tfoot>
            <tbody class="tbody-lines">
                <apex:repeat value="{!PedidoDeCompra__c.PedidoLineItems__r}" var="line">
                <tr class="dataRow even odd first last">
                    <td class="dataCell" colspan="1"><apex:outputText value="{!line.ProformaLineItem__r.producto__r.CodigoDeProductoBase__c}"/></td>
                    <td class="dataCell" colspan="1"><apex:outputText value="{!line.ProformaLineItem__r.producto__r.Marca2__c}"/></td>
                    <td class="dataCell" colspan="1"><apex:outputText value="{!line.ProformaLineItem__r.producto__r.Descripcion_Larga__c}"/></td>
                    <td class="dataCell" colspan="1"><apex:outputField value="{!line.Unidades__c}"/></td>
                    <td class="dataCell" colspan="1"><apex:outputField value="{!line.PrecioDeVenta__c}"/></td>
                    <td class="dataCell" colspan="1"><apex:outputField value="{!line.PrecioDeVentaTot__c}"/></td>
                </tr>
                </apex:repeat>
            </tbody>
        </table>
        <table style="border: 1px solid black;border-collapse: collapse;" width="100%">
           <tr>
              <td class="summary sub-summary"><apex:outputText value="TOTAL: U.S. DOLLARS {!numberSpell}"/></td>
           </tr>
           <tr>
              <td class="summary sub-summary"><apex:outputText value="{!labelFooter}"/></td>
           </tr>
        </table>
      
        </apex:pageBlock>
        <br/><br/><br/><br/>

         <!-- apex:outputPanel layout="block" styleClass="lineSmall"/> -->
        <apex:outputPanel layout="block">
            <apex:panelGrid columns="3" columnClasses="left,none">
                <apex:outputPanel >
                        <b>SIGNATURE:</b><br/><br/>
                        <apex:outputText value="{!beneficiario}"/><br/><br/>
                </apex:outputPanel>
                <div style="width:200px" />
                <apex:outputPanel >
                    <b>BANK DETAILS:</b><br/><br/>
                    Beneficiary : <b><apex:outputText value="{!beneficiario}"/></b><br/>
                    Account Number: <b><apex:outputText value="{!numeroDeCuenta}"/></b><br/>
                    Beneficiary Bank: <b><apex:outputText value="{!bancoBeneficiario}"/></b><br/> 
                    Bank Address:  <b><apex:outputText value="{!direccionBanco}"/></b><br/>
                    SWIFT CODE: <b><apex:outputText value="{!swiftCode}"/></b><br/>
                </apex:outputPanel>
            </apex:panelGrid>
        </apex:outputPanel>
    </body>
</apex:page>