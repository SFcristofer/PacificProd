<apex:includeScript value="https://code.jquery.com/jquery-3.3.1.min.js" />

    <script>
       /*
        * This function validates the value of the required fields.
        * If all the fields has a value, it continues. Otherwise it shows 
        * an error message.
        */
        function validateFields(elemBtn) {
            var result;
            var fileInvoiceValue;
            var filePLValue;
            var fileLRValue;
            var fieldDateCtnrValue;
            var fieldInvoiceNumberValue;
            var fieldInvoiceDateValue;
            
            var messageAlert = '';
            var inputFileInvoice = document.querySelector("[id*='inputInvoiceF']");
            var inputFilePL = document.querySelector("[id*='inputPLF']");
            var inputFileLR = document.querySelector("[id*='inputLoadingReportF']");
            var inputFieldCtnr = document.querySelector("[id*='dateCtnr']");
            
            var inputInvoiceNumber = document.querySelector("[id*='invoiceNumber']");
            var inputInvoiceDate = document.querySelector("[id*='invoiceDate']");            

            var isInvoiceNumber = true;
            var isInvoiceDate = true;
            var isInvoice = true;
            var isPList = true;
            var isLReport = true;
            var isDateLoad = true;
            var elementP = document.querySelector("[id*='validationMessages']");

            if(inputInvoiceNumber != null && inputInvoiceDate != null && inputFileInvoice != null && inputFilePL != null) {
            //if(inputFileInvoice != null && inputFilePL != null && inputFileLR != null && inputFieldCtnr != null) {
                fileInvoiceValue = inputFileInvoice.value;
                filePLValue = inputFilePL.value;
                /*fileLRValue = inputFileLR.value;
                fieldDateCtnrValue = inputFieldCtnr.value;*/
                
                fieldInvoiceNumberValue = inputInvoiceNumber.value;
                fieldInvoiceDateValue = inputInvoiceDate.value;

                if(fieldInvoiceNumberValue === "") {
                    messageAlert = messageAlert + ' Invoice Number is missing.<br/>';
                    isInvoiceNumber = false;
                }

                if(fieldInvoiceDateValue === "") {
                    messageAlert = messageAlert + ' Invoice Date is missing.<br/>';
                    isInvoiceDate = false;
                }

                
                if(fileInvoiceValue === "") {
                    messageAlert = messageAlert + ' Invoice file is missing.<br/>';
                    isInvoice = false;
                }
                if(filePLValue === "") {
                    messageAlert = messageAlert + ' Packing List file is missing.<br/>';
                    isPList = false;
                }
                /*if(fileLRValue === "") {
                    messageAlert = messageAlert + ' Loading Report file is missing.<br/>';
                    isLReport = false;
                }
                if(fieldDateCtnrValue === "") {
                    messageAlert = messageAlert + ' Date Load Container is missing.<br/>';
                    isDateLoad = false;
                }*/

                //if(isInvoice && isPList && isLReport && isDateLoad) {
                if(isInvoiceNumber && isInvoiceDate && isInvoice && isPList) {
                    elemBtn.disabled = true;
                    elemBtn.style.color = '#CCC';
                    //elemBtn.value='{!$Label.GENERIC_SAVING}';
                    elemBtn.value='Saving';                    
                    save();
                    return false;
                } else {
                    result = false;
                    elementP.innerHTML = messageAlert;
                    elementP.style.color = 'red';                    
                    //alert(messageAlert);
                }
            }
            return result;
            
        }

    </script>


