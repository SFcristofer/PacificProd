            <td class="uploadSV"><apex:inputField id="invoiceNumber" ignoreEditPermissionForRendering="true" value="{!pedido.Numero_de_Factura_Proveedor__c}"/></td>
        </tr>
        <tr>
            <td class="uploadS">INVOICE *</td>
            <td class="uploadSV"><apex:inputFile id="inputInvoiceF" value="{!finputInvoice.fileBody}" filename="{!finputInvoice.fileName}" style="float:left"/></td>
        </tr>
        <tr>
            <td></td>
            <td>
                <table>
                  <apex:repeat value="{!invoiceDocs}" var="docinv">
                    <tr>
                       <td style="padding: 5px;"><apex:outputText value="{!docinv.Name}" /></td>
                    </tr>
                  </apex:repeat>
                </table>
            </td>
        </tr>
        <tr>
            <td class="uploadS">PACKING LIST *</td>
            <td class="uploadSV"><apex:inputFile id="inputPLF" value="{!finputPL.fileBody}" filename="{!finputPL.fileName}" style="float:left"/></td>
        </tr>
        <tr>
            <td></td>
            <td>
                <table>
                  <apex:repeat value="{!plDocs}" var="docpl">
                    <tr>
                       <td style="padding: 5px;"><apex:outputText value="{!docpl.Name}" /></td>
                    </tr>
                  </apex:repeat>
                </table>
            </td>
        </tr>
    </table>
    <p id="validationMessages"></p>
            

    <table style="margin-left:40px">
        <tr>
          <td class="uploadBTN">
              <apex:actionFunction name="save" action="{!saveOrder}" />
              <apex:commandButton value="Upload/Save" id="saveBtn" onclick="validateFields(this);return false"/>
          </td>
          
          <td class="uploadBTN">
              <apex:commandButton value="Cancel" id="cancelBtn" action="{!cancelCntnrs}"/>
          </td>
        </tr>
    </table>

</apex:form>

</html>

</apex:page>