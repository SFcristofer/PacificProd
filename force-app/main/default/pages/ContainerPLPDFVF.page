    </tr>
</table>

<!-- repeat for each container ----------------------------------------------------------->
<apex:repeat value="{!pdfDoc.containersPDF}" var="cntr">
<br/>
<table style="width:100%;">
    <tr>
        <td class="dtcncu">CONTAINER NO:</td>
        <td class="dtcncd"><apex:outputText value="{!cntr.containerNumber}"/></td>
        <td class="dtcnct">WEIGHT:</td>
        <td class="dtcncc"><apex:outputText value="{!cntr.totalWeight}"/> KG</td>
    </tr>
    
    <tr>
        <td class="dtcncu">SEAL NO:</td>
        <td class="dtcncd"><apex:outputText value="{!cntr.seal}"/></td>
        <td class="dtcnct">VOLUME:</td>
        <td class="dtcncc"><apex:outputText value="{!cntr.totalCBM}"/> CBM</td>
    </tr>
    
    <tr>
        <td class="dtcncu">TYPE:</td>
        <td class="dtcncd">40HC</td>
        <td class="dtcnct"></td>
        <td class="dtcncc"></td>
    </tr>

</table>
<br/>
<table style="width:100%;">
    <!-- repeat for each item ---------------------------------->
<apex:repeat value="{!cntr.items}" var="item">
    <tr>
        <td class="itempgref"><apex:outputText value="{!item.pgRef}"/></td>
        <td class="itemmark"><apex:outputText value="{!item.brandItemInvoice}"/></td>
        <td class="itemnull">&nbsp;</td>
        
        <!-- td class="itemsdesc"><apex:outputText value="{!item.spanishName}"/></td -->
        <td class="itemsdesc"><apex:outputText value="{!item.englishName}"/></td>        
        
        <td class="itemsqty"><apex:outputText value="{!ROUND(item.qty, 0)}"/></td>
        <td class="itemscnt"><apex:outputText value="{!ROUND(item.cnt, 0)}"/></td>
        <td class="itemspcs"><apex:outputText value="{!ROUND(item.units, 0)}"/></td>
    </tr>
    
    <tr class="spacerow">
        <td class="itempgref">&nbsp;</td>
        <td class="itemmark">&nbsp;</td>
        <td class="itemnull">&nbsp;</td>
        <td class="itemsdesc">
            <table style="width:100%;border-spacing: 0;border-collapse: collapse;">
            <!-- repeat for each item feature ----------->
            <apex:repeat value="{!item.features}" var="feat">            
                <tr>
                  <td class="{!feat.cssClassLbl}"><apex:outputText value="{!feat.featureName}"/></td>
                  <td class="{!feat.cssClassVal}"><apex:outputText value="{!feat.featureValue}"/></td>
                </tr>
                
                <!-- tr>
                  <td class="itemfgrossw">GROSS WT:</td>
                  <td class="itemfgrosswval">16,684.00 KG</td>
                </tr>

                <tr>
                  <td class="itemfcbm">CBM:</td>
                  <td class="itemfcbmval">67.9 CBM</td>
                </tr>

                <tr>
                  <td class="itemfean">EAN:</td>
                  <td class="itemfeanval">860009618329</td>
                </tr -->
            <!-- repeat for each item feature ----------->
            </apex:repeat>
            </table>
        </td>
        <td class="itemsqty">&nbsp;</td>
        <td class="itemscnt">&nbsp;</td>
        <td class="itemspcs">&nbsp;</td>
    </tr>    
    <!-- repeat for each item ---------------------------------->
</apex:repeat>
</table>     
<!-- repeat for each container ----------------------------------------------------------->
</apex:repeat>


