    </tr>
    <tr>
        <td class="pgcad"><apex:outputText value="{!pdfDoc.companyAddressLine2}"/></td>
    </tr>
    <tr>
        <td class="pgcad"><apex:outputText value="{!pdfDoc.companyAddressLine3}"/></td>
    </tr>            
</table>
<br/>
<table style="width:100%;">
    <tr>
        <td class="pltxt"><apex:outputText value="{!pdfDoc.documentName}"/></td>
    </tr>
</table>
<br/>
<table style="width:100%;">
   <tr>
     <td class="columnOneTo">TO: </td>
     <td class="columnTwo">DATE: </td>
