<body>

<table style="width:100%">
    <tr>
        <td style="text-align: center;"><apex:image url="{!URLFOR($Resource[pdfDoc.staticResourceName], pdfDoc.imageName)}" width="300" height="55"/></td>
    </tr>
</table>
<br/>
<table style="width:100%;">
    <tr>
        <td class="pgc"><apex:outputText value="{!pdfDoc.companyName}"/></td>
    </tr>
    <tr>
