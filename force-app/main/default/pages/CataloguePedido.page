<apex:page docType="html-5.0" showHeader="false" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" Controller="CatalogoController" cache="false">

    <html class="no-js" lang="en" dir="ltr">

    <head>
        <meta charset="utf-8" />
        <meta http-equiv="x-ua-compatible" content="ie=edge" /> 
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Quote Request - {!catalogo.Cliente__r.Name} - Pacific Global</title>
        <link href="https://fonts.googleapis.com/css?family=Fira+Sans:300,300i,400,400i,500,500i,700,700i,900,900i|Montserrat:200,400,600,700,800"
            rel="stylesheet" />
        <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.2/css/all.css" integrity="sha384-oS3vJWv+0UjzBfQzYUhtDYW+Pj2yciDJxpsK1OYPAYjqT085Qq/1cq5FLXAZQ7Ay"
            crossorigin="anonymous" />
        <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/foundation.css')}" />
        <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick.css')}" />
        <!-- Add the new slick-theme.css if you want the default styling -->
        <link rel="stylesheet" type="text/css" href="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick-theme.css')}" />
        <!-- Custom styles -->
        <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/app.css')}" />
        <link rel="stylesheet" href="{!URLFOR($Resource.doBrandsCatalogo, 'css/responsive.css')}" />
        <style>
            .editable-comment{
                display:none;
            }

            .light {
                color:#089EBA;
                background-color: #FFF !important;
            }
        </style>
    </head>

    <body>
        <apex:PageMessages id="portalProvMsgs" rendered="true" />

        <apex:outputPanel rendered="{!showPage}">
            <apex:form >
                <div class="grid-container">
                    <div id="header" class="grid-x grid-padding-x">
                        <div class="small-6 medium-3 cell">
                            <a href="/portal/CatalogueIndex">
                                <img id="inner-logo" src="{!URLFOR($Resource.doBrandsCatalogoImages, 'img/pacific-logo.svg')}" alt="do brands logo" height="96"
                                />
                            </a>
                        </div>
                        <div class="medium-9 cell hide-for-small show-for-large">
                            <ul id="main-menu" class="align-right dropdown menu" data-dropdown-menu="true">
                                <li id="go-home">
                                    <a href="/portal/CatalogueIndex">
                                        <span>Home</span>
                                    </a>
                                </li>

                                <apex:repeat value="{!catalogoGUI.familias}" var="itemF">
                                    <apex:variable var="imageMSF" value="{!itemF.imagenSF}" />

                                    <li id="go-do-home" class="{!itemF.descripcion}">
                                        <a href="/portal/CatalogueSubfamily?fam={!itemF.clave}" class="{!itemF.classSubfamiliaMenu}">
                                            <span>
                                                <img src="{!URLFOR($Resource.doBrandsCatalogoImages, imageMSF)}" class="{!itemF.descripcion}" style="width:139px;height:32px;"/>
                                            </span>
                                        </a>
                                        <ul class="menu">
                                            <apex:repeat value="{!itemF.subfamilias}" var="itemMS">
                                                <li>
                                                    <a href="/portal/CatalogueSubfamily?fam={!catalogoGUI.currentFamily.clave}&sfm={!itemMS.clave}">{!itemMS.descripcion}</a>
                                                </li>
                                            </apex:repeat>
                                        </ul>
                                    </li>

                                </apex:repeat>


                                <li>
                                    <apex:outputPanel id="cart">
                                        <a href="#" style="{!styleCartHref}">
                                            <i class="fas fa-dolly-flatbed"></i>
                                            <span style="{!styleCartSpan}">{!IF(numberProductsCart != '0', numberProductsCart, '')}</span>
                                        </a>
                                    </apex:outputPanel>
                                </li>
                            </ul>
                        </div>
                        <div id="responsive-menu-header" class="small-6 medium-9 cell hide-for-large">
                            <ul class="menu">
                                <li>
                                    <apex:outputPanel id="cart-responsive">
                                        <a href="/portal/CataloguePedido" style="{!styleCartHref}">
                                            <i class="fas fa-dolly-flatbed"></i>
                                            <span style="{!styleCartSpan}margin:0px !important;">{!IF(numberProductsCart != '0', numberProductsCart, '')}</span>
                                        </a>
                                    </apex:outputPanel>
                                </li>
                                <li id="show-menu">
                                    <a href="#show-menu">
                                        <i class="fa fa-bars" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li id="hide-menu">
                                    <a href="#hide-menu">
                                        <i class="fa fa-times" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Responsive Menu -->
                <div id="responsive-menu">
                    <div class="grid-container">
                        <div class="grid-x">
                            <div class="small-12 cell">
                                <ul id="" class="">
                                    <apex:repeat value="{!catalogoGUI.familias}" var="itemF">
                                        <li id="go-do-home">
                                            <a href="/portal/CatalogueSubfamily?fam={!itemF.clave}" class="{!itemF.classSubfamiliaMenu}">
                                                <span>
                                                    <img src="{!URLFOR($Resource.doBrandsCatalogoImages, itemF.imagenSF)}" class="{!itemF.descripcion}" />
                                                </span>
                                            </a>
                                        </li>
                                    </apex:repeat>
                                    <li id="go-home">
                                        <a href="/portal/CatalogueIndex">
                                            <span>Home</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="grid-container">
                    <div class="grid-x grid-padding-x">
                        <div class="small-12 cell text-center">
                            <h1>Quote Request:&nbsp;
                                <apex:outputText value="{!catalogo.Cliente__r.Name}" />
                            </h1>
                        </div>
                    </div>
                </div>

                <div class="divider1"></div>
                <apex:outputPanel id="itemsCart" styleClass="grid-container" layout="block">

                    <div class="grid-x grid-margin-x align-center">

                        <apex:repeat value="{!pedidoCatalogo.productos}" var="itemPr">

                            <div class="small-12 large-4 cell producto-pedido">
                                <div class="grid-container">
                                    <div class="grid-x grid-padding-x">
                                        <div class="imagen-producto small-offset-2" title="{!itemPr.prodName}">
                                            <img src="/portal/servlet/servlet.FileDownload?file={!IF(itemPr.prodImageId != null, itemPr.prodImageId, '015460000005lAl')}" />
                                        </div>
                                        <div class="small-12 cell">
                                            <a href="/portal/CatalogueProduct?fam={!itemPr.prodFamPrefix}&sfm={!itemPr.prodSfmPrefix}&cla={!itemPr.prodClaPrefix}&pro={!itemPr.prodCode}"
                                                title="{!itemPr.prodName}">
                                                <h2>{!itemPr.prodName}</h2>
                                            </a>
                                            <apex:commandLink action="{!deleteProductFromCart}" styleClass="delete-product" reRender="EnviarButton, itemsCart, cart, cart-responsive">
                                                <apex:param name="selectedDeleteProduct" value="{!itemPr.prodCode}" />
                                                <i class="far fa-trash-alt" onmouseover="iconAnimation(this)" onmouseout="iconAnimation(this)"></i>
                                            </apex:commandLink>
                                        </div>
                                        <div class="small-12 cell">
                                            <div class="grid-x">
                                                <div class="small-6 cell text-left">
                                                    <p>
                                                        <strong style="color: #0a0a0a;">Code:</strong> {!itemPr.prodCode}</p>
                                                </div>
                                                <div class="small-6 cell text-left">
                                                    <p>
                                                        <strong style="color: #0a0a0a;">Sizes:</strong> {!itemPr.prodMeasures}</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="small-12 cell">
                                            <p>
                                                <span style="width: 100%; display: inline-block; margin-top: 8px;">
                                                    <strong style="color: #0a0a0a;">Packaging:</strong>
                                                </span>
                                            </p>
                                            <div style="column-count: 3; margin-top: 8px;">
                                                <ul id="box-selector" class="no-bullet boxes" style="display:inline">
                                                    <li id="box-brown" class="{!IF(itemPr.selectedBrown, 'selected', '')}" onclick="changePackaging(this, '{!itemPr.prodCode}', 'brown box')">
                                                        <img src="{!URLFOR($Resource.doBrandsCatalogoImages, 'img/brown-box.png')}" />
                                                    </li>
                                                    <li id="box-white" class="{!IF(itemPr.selectedWhite, 'selected', '')}" onclick="changePackaging(this, '{!itemPr.prodCode}', 'white box')">
                                                        <img src="{!URLFOR($Resource.doBrandsCatalogoImages, 'img/white-box.png')}" />
                                                    </li>
                                                    <li id="box-full-color" class="{!IF(itemPr.selectedColor, 'selected', '')}" onclick="changePackaging(this, '{!itemPr.prodCode}', 'color box')">
                                                        <img src="{!URLFOR($Resource.doBrandsCatalogoImages, 'img/full-color-box.png')}" />
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="small-12 cell">
                                            <p>
                                                <span style="width: 100%; display: inline-block;margin:5px 0;">
                                                    <strong style="color: #0a0a0a;">Comments:</strong>
                                                    <a class="edit-comment" onclick="showEditCommentOverlay(this)">
                                                        <i class="fas fa-edit" onmouseover="iconAnimation(this)" onmouseout="iconAnimation(this)"></i>
                                                    </a>
                                                </span>
                                                <br/>
                                                <apex:outputText styleClass="fixed-comment" value="{!itemPr.comments}" />
                                                <textarea class="editable-comment" rows="4" cols="50"
                                                        onkeypress="saveComment(this)" onblur="saveComment(this)" data-p-code="{!itemPr.prodCode}">{!itemPr.comments}</textarea>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </apex:repeat>

                    </div>
                </apex:outputPanel>


                <div class="grid-container">
                    <div class="grid-x grid-padding-x">
                        <apex:outputPanel id="EnviarButton" styleClass="small-12 cell text-center">
                            <apex:commandLink id="enviar-pedido" action="{!enviarCotizacion}" value="Send quote request" styleClass="button"
                                rendered="{!NOT(numberProductsCart = '')}" />
                        </apex:outputPanel>
                    </div>
                </div>
                <div class="divider2"></div>

                <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/jquery.js')}"></script>
                <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/what-input.js')}"></script>
                <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/vendor/foundation.js')}"></script>
                <script src="{!URLFOR($Resource.doBrandsCatalogo, 'js/app.js')}"></script>
                <script type="text/javascript" src="{!URLFOR($Resource.doBrandsCatalogo, 'slick/slick.min.js')}"></script>
                <script type="text/javascript">
                    $(document).ready(function () {
                        $('.product-img-slider').slick({
                            slidesToShow: 1,
                            slidesToScroll: 1,
                            arrows: false,
                            fade: true,
                            asNavFor: '.slider-nav'
                        });
                        $('.slider-nav').slick({
                            slidesToShow: 3,
                            slidesToScroll: 1,
                            asNavFor: '.product-img-slider',
                            dots: false,
                            centerMode: true,
                            focusOnSelect: true
                        });

                    });

                    function changePackaging(elem, pCode, boxColor) {
                        var siblings = [];
                        var sibling = elem.parentNode.firstChild;
                        while (sibling) {
                            sibling.className = '';
                            sibling = sibling.nextElementSibling || sibling.nextSibling;
                        }
                        elem.className = 'selected';

                        chPackaging(pCode, boxColor);

                    }

                    function showEditCommentOverlay(elem) {
                        var sibling = elem.parentNode.parentNode.firstChild;
                        //show input field, hide fixed text and gray out edit icon
                        while (sibling) {
                            if(sibling.className == 'fixed-comment') {
                                sibling.style.display = 'none';
                            }
                            if(sibling.className == 'editable-comment') {
                                sibling.style.display = 'block';
                                sibling.focus();
                                sibling.setSelectionRange(sibling.value.length,sibling.value.length);
                            }
                            sibling = sibling.nextElementSibling || sibling.nextSibling;
                            elem.style.color = '#D1D1D1';
                        }
                    }

                    function saveComment(elem) {
                        //on enter key (or input focus lost) copy the content to the fixed text and light up edit icon
                        if (event.type == 'blur' || event.keyCode === 13) {
                            var fixedText = elem.previousElementSibling || elem.previousSibling;
                            fixedText.innerHTML = elem.value;
                            fixedText.style.display = 'block';
                            elem.style.display = 'none';
                            var parentN = elem.parentNode;
                            elem.parentNode.firstElementChild.firstElementChild.nextElementSibling.style.color = 'black';
                        }
                        //controller save comment changes to cookie action
                        chComment(elem.dataset.pCode, elem.value);
                    }

                    function iconAnimation(elem) {
                        elem.classList.toggle('light');
                    }

                </script>

                <apex:actionFunction name="chPackaging" action="{!changePackaging}" rerender="none">
                    <apex:param name="pCode" value="" />
                    <apex:param name="pSel" value="" />
                </apex:actionFunction>

                <apex:actionFunction name="chComment" action="{!changeComment}" rerender="none">
                    <apex:param name="pCode" value="" />
                    <apex:param name="cmm" value="" />
                </apex:actionFunction>

            </apex:form>
        </apex:outputPanel>

    </body>

    </html>

</apex:page>