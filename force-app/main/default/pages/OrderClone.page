<apex:page standardController="PedidoDeCompra__c" extensions="OrderCloneController" showHeader="true" title="Pedido duplicado" tabStyle="Account" id="page" action="{!cloneOrder}">
    <head>
      <style>

        .tabla {
          border-collapse: collapse;
        }
  
        .titulo {
          text-align: center;
          font-size: 20px;
          font-weight: bold;
          border: 1px solid black;
          background-color: #F7CAAC;
          
        }
        
        .valorColumna {
          border-collapse: collapse;
          border: 1px solid black;
        }
        
      </style>
    </head>

    <body>
    <apex:form id="form">
        <center>
            <table class="tabla">
              <tr>
                <td class="titulo">Nuevo pedido</td>
              </tr>
              
              <tr>
                <td class="valorColumna"><apex:outputLink value="/{!idOrderCloned}"> - Da clic para revisar el nuevo pedido </apex:outputLink></td>
              </tr>
            </table>
        </center> 
    </apex:form>
    </body>

</apex:page>