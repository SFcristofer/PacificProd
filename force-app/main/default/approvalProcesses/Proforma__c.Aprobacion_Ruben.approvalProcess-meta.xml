<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Cuenta__c</field>
        <field>ImporteTotal__c</field>
        <field>MargenOperacion__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ruben.bernardo@pacificglob.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Aprobación Rubén</label>
        <name>Paso_1</name>
    </approvalStep>
    <emailTemplate>unfiled$public/Solicitud_de_Aprobacion</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
  OR(
    MargenOperacion__c &lt; 18,
    (Cuenta__r.Parent.Balance_Cuenta__c - ImporteTotal__c) &lt; 0,
     Importe_Venta_Neto_Nuevo__c &gt; 40000
  ),
  MargenOperacion__c &gt;= 16,
  Importe_Venta_Neto_Nuevo__c &lt;= 80000,
  (Cuenta__r.Parent.Balance_Cuenta__c - ImporteTotal__c) &gt;= -10000
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Aprobado_Direccion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Desbloqueo</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FechaAprobacionDireccion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Resultado_Aprobada</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Resultado_Rechazada</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>FechaEnviadoAprobacion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Resultado_Enviada</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Aprobación solo Rubén</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
