<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Cuenta__c</field>
        <field>ImporteTotal__c</field>
        <field>MargenOperacion__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ruben.bernardo@pacificglob.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>El usuario era anteriormente Kareny Benavides</description>
        <entryCriteria>
            <formula>OR (
MargenOperacion__c &lt; 0.18 ,
( Cuenta__r.Parent.Balance_Cuenta__c - ImporteTotal__c ) &lt; 0
)</formula>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Aprobación #1</label>
        <name>Paso1</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>ruben.bernardo@pacificglob.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <formula>OR (
MargenOperacion__c &lt; 0.14 ,
( Cuenta__r.Parent.Balance_Cuenta__c - ImporteTotal__c ) &lt; -20000
)</formula>
        </entryCriteria>
        <label>Aprobación Rubén</label>
        <name>Paso2</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>unfiled$public/Solicitud_de_Aprobacion</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Aprobado_Direccion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Desbloqueo</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>FechaAprobacionDireccion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Resultado_Aprobada</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Resultado_Rechazada</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>FechaEnviadoAprobacion</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Resultado_Enviada</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Aprobación de proforma</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
