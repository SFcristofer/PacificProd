<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ImporteVentaNeto__c</fullName>
    <description>Usado por el sistema para el cálculo de margen a nivel del line item</description>
    <formula>PrecioDeVentaTot__c - (PrecioDeVentaTot__c * (PedidoDeCompra__r.Proforma__r.Cuenta__r.PorcentajeAportaciones__c + PedidoDeCompra__r.Proforma__r.Cuenta__r.PorcentajeConvenio__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Usado por el sistema para el cálculo de margen a nivel del line item</inlineHelpText>
    <label>Importe Venta Neto</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
