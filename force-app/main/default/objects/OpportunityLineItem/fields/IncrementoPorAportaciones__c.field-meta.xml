<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IncrementoPorAportaciones__c</fullName>
    <formula>UnitPrice - ( UnitPrice * ( 1 - (Aportaciones__c + Convenio__c + Porcentaje_Item__c) ) )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Incremento por aportaciones y convenio</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
